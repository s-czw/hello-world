{
  "name": "@cairn/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Cairn typed API client — generated from apps/api/openapi.json",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "gen": "openapi-typescript ../../apps/api/openapi.json -o ./src/schema.d.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.5"
  },
  "devDependencies": {
    "openapi-typescript": "^7.6.1",
    "tsup": "^8.5.0",
    "typescript": "^5.7.3"
  }
}
