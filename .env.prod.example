# ---------------------------------------------------------------------------
# Cairn — production/staging environment template.
#
#   cp .env.prod.example .env.prod
#   chmod 600 .env.prod        # it holds secrets; it is git-ignored
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# Every variable the prod stack reads is listed here. Values shown are the shipped defaults
# except where marked REQUIRED. Avoid `$` in secret values — Docker Compose interpolates it
# (write `$$` for a literal dollar sign).
# ---------------------------------------------------------------------------

# --- Public identity -------------------------------------------------------
# REQUIRED. The single hostname Cairn is served on. Its A/AAAA record must already point at
# this host before first start, or the ACME HTTP-01 challenge cannot complete.
# Used for: the Traefik routers (web + api) and APP_PUBLIC_URL (invite links).
CAIRN_DOMAIN=cairn.example.com

# REQUIRED. Let's Encrypt account e-mail (expiry notices; must be deliverable).
#
# !! Traefik's STATIC configuration file cannot read environment variables, and Traefik uses a
# !! single static-config source, so this value ALSO has to be written into
# !! docker/traefik/traefik.yml (certificatesResolvers.letsencrypt.acme.email).
# !! DEPLOY.md step 3 does that with one `sed`. Keep the two in sync.
ACME_EMAIL=ops@example.com

# --- Database (PostgreSQL 16) ---------------------------------------------
POSTGRES_DB=cairn
POSTGRES_USER=cairn
# REQUIRED. Generate with:  openssl rand -base64 24 | tr -d '=+/$'
POSTGRES_PASSWORD=change-me-strong-db-password

# --- Sessions / auth -------------------------------------------------------
# REQUIRED. HS256 signing key for the cairn_access JWT — at least 32 bytes.
# Generate with:  openssl rand -base64 48 | tr -d '=+/$'
# Rotating it immediately invalidates every issued access token (users re-login).
AUTH_JWT_SECRET=change-me-at-least-32-bytes-of-random-secret-material

# TLS is terminated at Traefik, so session cookies must be Secure. Leave true in production.
AUTH_COOKIE_SECURE=true
# Local e-mail+password provider (D-020). Additional providers toggle here as they land.
AUTH_LOCAL_ENABLED=true
# Login rate limiting (5 attempts / minute / ip+email), counters in Valkey.
AUTH_RATELIMIT_ENABLED=true

# --- Attachments (D-028: local disk, not object storage) -------------------
# Path INSIDE the api container; the named volume cairn_attachments is mounted here and the
# backup sidecar snapshots it read-only. Change it only if you also change nothing else —
# the compose file uses this same value for the mount point.
CAIRN_STORAGE_DIR=/data/attachments

# --- In-app notifications (F1) --------------------------------------------
CAIRN_NOTIF_RETENTION_DAYS=90
CAIRN_NOTIF_PURGE_ENABLED=true
# Spring cron (6 fields, server time = TZ below). Default: daily 03:30.
CAIRN_NOTIF_PURGE_CRON=0 30 3 * * *

# --- Backups (backup sidecar) ---------------------------------------------
# Nightly pg_dump -Fc + attachment tarball into the cairn_backups volume, pruned by age.
BACKUP_HOUR_UTC=3
BACKUP_MINUTE_UTC=15
BACKUP_RETENTION_DAYS=14
# Set true to also take one backup immediately when the sidecar starts (handy on first deploy
# and before an upgrade).
BACKUP_ON_START=false

# --- Runtime ---------------------------------------------------------------
# JVM flags for the api container. MaxRAMPercentage lets the JVM size itself from the
# container memory limit; SerialGC suits the single small replica of the lean MVP.
JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+UseSerialGC
TZ=UTC

# Tag applied to the images built by this stack (`cairn-api:<tag>`, `cairn-web:<tag>`).
# Bump it per release so `docker image ls` shows what is deployed and rollback has something
# to point at.
CAIRN_IMAGE_TAG=local
